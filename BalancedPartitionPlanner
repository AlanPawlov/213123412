namespace MeshGeneration.SurfacePartitioning
{
    [ExecuteAlways]
    [DisallowMultipleComponent]
    [RequireComponent(typeof(MeshFilter), typeof(MeshRenderer))]
    public sealed class SurfacePartitioner : MonoBehaviour
    {
        private const string GeneratedRootName = "Surface Partitions (Generated)";

        [SerializeField] private SurfacePartitionDefinition _definition;
        [SerializeField] private MeshFilter _sourceMeshFilter;
        [SerializeField] private MeshRenderer _sourceMeshRenderer;
        [SerializeField] private Material _materialOverride;
        [SerializeField, HideInInspector] private Transform _generatedRoot;

        public SurfacePartitionDefinition Definition => _definition;
        public int GeneratedPieceCount => _generatedRoot == null ? 0 : _generatedRoot.childCount;

        public string LastPartitionError { get; private set; }

        [ContextMenu("Partition")]
        public void Partition()
        {
            if (!TryPartition(out string error))
                Debug.LogWarning(error, this);
        }

        // Staging owns every newly built mesh until commit. Failed attempts leave the visible
        // generation, source renderer and source collider exactly as they were.
        public bool TryPartition(out string error)
        {
            Transform staging = null;
            error = null;
            try
            {
                ResolveReferences();
                ValidateInput();
                Mesh sourceMesh = _sourceMeshFilter.sharedMesh;
                Vector3 scale = Abs(transform.lossyScale);
                Bounds bounds = ScaleBounds(sourceMesh.bounds, scale);
                List<Vector2> footprint = SourceFootprintExtractor.Extract(sourceMesh, scale);
                SurfacePartition partition;
                bool built = SourceFootprintExtractor.IsAxisAlignedRectangle(footprint)
                    ? SurfacePartitionGenerator.TryGenerate(bounds.size.x / bounds.size.z,
                        _definition.PieceCount, _definition.ComplexPieceRatio, _definition.MaxRectanglesPerPiece,
                        _definition.MaxComplexLegAspect, _definition.MaxPieceAspect,
                        _definition.TargetCellsPerRectangle, _definition.Seed,
                        _definition.MinPieceAreaRatio, _definition.MaxPieceAreaRatio,
                        _definition.MinLegThicknessRatio, out partition)
                    : MaskedSurfacePartitionGenerator.TryGenerate(footprint, bounds,
                        _definition.PieceCount, _definition.ComplexPieceRatio, _definition.MaxRectanglesPerPiece,
                        _definition.MaxComplexLegAspect, _definition.MaxPieceAspect,
                        _definition.TargetCellsPerRectangle, _definition.Seed,
                        _definition.MinPieceAreaRatio, _definition.MaxPieceAreaRatio,
                        _definition.MinLegThicknessRatio, out partition);
                if (!built)
                {
                    error = $"Surface partitioner on '{name}' could not satisfy the shape and area limits " +
                        $"for {_definition.PieceCount} pieces (seed {_definition.Seed}). Previous output was preserved.";
                    LastPartitionError = error;
                    return false;
                }
                var root = new GameObject(GeneratedRootName + " (Staging)");
                root.SetActive(false);
                staging = root.transform;
                staging.SetParent(transform, false);
                staging.localScale = Reciprocal(scale);
                Material material = _materialOverride != null ? _materialOverride : _sourceMeshRenderer.sharedMaterial;
                for (int i = 0; i < partition.Regions.Count; i++)
                    CreatePiece(i, partition.Regions[i], partition.Columns, partition.Rows, bounds, material, staging);

                ClearGeneratedInternal(false);
                _generatedRoot = staging;
                staging = null;
                _generatedRoot.name = GeneratedRootName;
                _generatedRoot.gameObject.SetActive(true);
                _sourceMeshRenderer.enabled = false;
                Collider sourceCollider = GetComponent<Collider>();
                if (sourceCollider != null) sourceCollider.enabled = false;
                LastPartitionError = null;
                return true;
            }
            catch (Exception exception)
            {
                DestroyRoot(staging);
                error = $"Surface partitioner on '{name}': {exception.Message}";
                LastPartitionError = error;
                return false;
            }
        }

        [ContextMenu("Clear Partitions")]
        public void ClearPartitions()
        {
            ClearGeneratedInternal(true);
        }

        private void Reset()
        {
            ResolveReferences();
        }

        private void OnEnable()
        {
            ResolveReferences();
            if (_generatedRoot == null)
                _generatedRoot = transform.Find(GeneratedRootName);
        }

        private void ResolveReferences()
        {
            if (_sourceMeshFilter == null)
                _sourceMeshFilter = GetComponent<MeshFilter>();
            if (_sourceMeshRenderer == null)
                _sourceMeshRenderer = GetComponent<MeshRenderer>();
        }

        private void ValidateInput()
        {
            if (_definition == null)
                throw new InvalidOperationException($"{nameof(SurfacePartitioner)} on '{name}' requires a definition.");
            if (_sourceMeshFilter == null || _sourceMeshFilter.sharedMesh == null)
                throw new InvalidOperationException($"{nameof(SurfacePartitioner)} on '{name}' requires a source MeshFilter with a mesh.");
            if (_sourceMeshRenderer == null)
                throw new InvalidOperationException($"{nameof(SurfacePartitioner)} on '{name}' requires a source MeshRenderer.");

            Bounds bounds = _sourceMeshFilter.sharedMesh.bounds;
            if (bounds.size.x <= Mathf.Epsilon || bounds.size.y <= Mathf.Epsilon || bounds.size.z <= Mathf.Epsilon)
                throw new InvalidOperationException($"Source mesh '{_sourceMeshFilter.sharedMesh.name}' on '{name}' must have volume on X, Y and Z axes.");
        }

        private void CreatePiece(
            int index,
            SurfacePartitionRegion region,
            int columns,
            int rows,
            Bounds bounds,
            Material material,
            Transform parent)
        {
            Mesh mesh = PartitionMeshBuilder.Build(
                $"Surface Partition {index + 1:00}",
                region.Cells,
                columns,
                rows,
                bounds,
                _definition.Gap,
                _definition.CornerRadius,
                _definition.CornerSegments,
                _definition.EdgeBevel,
                _definition.BevelSegments,
                _definition.RoundingAxes);

            GameObject piece = new GameObject($"Partition {index + 1:00}");
            piece.transform.SetParent(parent, false);

            MeshFilter filter = piece.AddComponent<MeshFilter>();
            filter.sharedMesh = mesh;

            MeshRenderer renderer = piece.AddComponent<MeshRenderer>();
            renderer.sharedMaterial = material;
            renderer.shadowCastingMode = _definition.CastShadows ? ShadowCastingMode.On : ShadowCastingMode.Off;
            renderer.receiveShadows = _definition.ReceiveShadows;

            if (_definition.GenerateMeshColliders)
            {
                MeshCollider collider = piece.AddComponent<MeshCollider>();
                collider.sharedMesh = mesh;
            }

            if (_definition.GenerateLabels)
                CreateLabel(piece, region, columns, rows, bounds);
        }

        private void CreateLabel(
            GameObject piece,
            SurfacePartitionRegion region,
            int columns,
            int rows,
            Bounds bounds)
        {
            TMP_FontAsset font = _definition.LabelFont;
            if (font == null)
                throw new InvalidOperationException(
                    $"{nameof(SurfacePartitionDefinition)} '{_definition.name}' requires a TMP font when labels are enabled.");

            PartitionLabelPlacement placement = PartitionLabelPlacementCalculator.Calculate(
                region.Cells,
                columns,
                rows,
                bounds,
                _definition.Gap,
                _definition.EdgeBevel,
                _definition.LabelPadding,
                _definition.LabelSurfaceOffset);

            GameObject labelObject = new GameObject("Label");
            // TMP must run Awake before entering the inactive staging hierarchy: its default
            // settings otherwise overwrite our font-size limits when staging is committed.
            TextMeshPro label = labelObject.AddComponent<TextMeshPro>();
            labelObject.transform.SetParent(piece.transform, false);
            labelObject.transform.localPosition = placement.Position;
            Quaternion lieFlat = Quaternion.Euler(90f, 0f, 0f);
            Quaternion verticalTurn = placement.IsVertical
                ? Quaternion.Euler(0f, 0f, 90f)
                : Quaternion.identity;
            labelObject.transform.localRotation = lieFlat * verticalTurn;

            label.font = font;
            label.text = _definition.LabelText;
            label.color = _definition.LabelColor;
            label.alignment = TextAlignmentOptions.Center;
            label.enableAutoSizing = true;
            label.fontSizeMin = 0.01f;
            label.fontSizeMax = 10f;
            label.textWrappingMode = TextWrappingModes.NoWrap;
            label.overflowMode = TextOverflowModes.Truncate;
            label.margin = Vector4.zero;
            label.rectTransform.sizeDelta = placement.TextArea;
            label.rectTransform.pivot = new Vector2(0.5f, 0.5f);
            label.ForceMeshUpdate(ignoreActiveState: true, forceTextReparsing: true);
        }

        private void ClearGeneratedInternal(bool restoreSource)
        {
            if (_generatedRoot == null)
                _generatedRoot = transform.Find(GeneratedRootName);

            DestroyRoot(_generatedRoot);
            _generatedRoot = null;

            if (!restoreSource)
                return;

            ResolveReferences();
            if (_sourceMeshRenderer != null)
                _sourceMeshRenderer.enabled = true;
            Collider sourceCollider = GetComponent<Collider>();
            if (sourceCollider != null)
                sourceCollider.enabled = true;
        }

        private static void DestroyRoot(Transform root)
        {
            if (root == null) return;
            root.gameObject.SetActive(false);
            for (int i = root.childCount - 1; i >= 0; i--)
            {
                MeshFilter filter = root.GetChild(i).GetComponent<MeshFilter>();
                if (filter != null && filter.sharedMesh != null) DestroyGeneratedObject(filter.sharedMesh);
            }
            // Deferred destruction in Play mode must not leave a second discoverable root.
            root.name = GeneratedRootName + " (Retired)";
            DestroyGeneratedObject(root.gameObject);
        }

        private static void DestroyGeneratedObject(UnityEngine.Object target)
        {
            if (target == null)
                return;

            if (Application.isPlaying)
                Destroy(target);
            else
                DestroyImmediate(target);
        }

        internal static Bounds ScaleBounds(Bounds sourceBounds, Vector3 scale)
        {
            return new Bounds(
                Vector3.Scale(sourceBounds.center, scale),
                Vector3.Scale(sourceBounds.size, scale));
        }

        internal static Vector3 Reciprocal(Vector3 scale)
        {
            return new Vector3(
                SafeReciprocal(scale.x),
                SafeReciprocal(scale.y),
                SafeReciprocal(scale.z));
        }

        private static Vector3 Abs(Vector3 value)
        {
            return new Vector3(Mathf.Abs(value.x), Mathf.Abs(value.y), Mathf.Abs(value.z));
        }

        private static float SafeReciprocal(float value)
        {
            return Mathf.Abs(value) <= Mathf.Epsilon ? 1f : 1f / value;
        }
    }
}

namespace MeshGeneration.SurfacePartitioning
{
    internal sealed class SurfacePartitionRegion
    {
        public readonly HashSet<Vector2Int> Cells = new HashSet<Vector2Int>();
        public int SourceRectangleCount;
        public float MaxSourceRectangleAspect;
    }

    internal sealed class SurfacePartition
    {
        public readonly int Columns;
        public readonly int Rows;
        public readonly IReadOnlyList<SurfacePartitionRegion> Regions;

        public SurfacePartition(int columns, int rows, IReadOnlyList<SurfacePartitionRegion> regions)
        {
            Columns = columns;
            Rows = rows;
            Regions = regions;
        }
    }

    internal static class SurfacePartitionGenerator
    {
        public static SurfacePartition Generate(float surfaceAspect, int pieceCount, float complexPieceRatio,
            int maxRectanglesPerPiece, float maxComplexLegAspect, float maxPieceAspect,
            int targetCellsPerRectangle, int seed,
            float minAreaRatio = SurfacePartitionDefinition.DefaultMinAreaRatio,
            float maxAreaRatio = SurfacePartitionDefinition.DefaultMaxAreaRatio,
            float minLegRatio = SurfacePartitionDefinition.DefaultMinLegRatio)
        {
            if (TryGenerate(surfaceAspect, pieceCount, complexPieceRatio, maxRectanglesPerPiece,
                maxComplexLegAspect, maxPieceAspect, targetCellsPerRectangle, seed,
                minAreaRatio, maxAreaRatio, minLegRatio, out SurfacePartition partition)) return partition;
            throw new InvalidOperationException($"No feasible rectangular partition for {pieceCount} pieces with the specified quality limits.");
        }

        internal static bool TryGenerate(float surfaceAspect, int pieceCount, float complexPieceRatio,
            int maxRectanglesPerPiece, float maxComplexLegAspect, float maxPieceAspect,
            int targetCellsPerRectangle, int seed, float minAreaRatio, float maxAreaRatio,
            float minLegRatio, out SurfacePartition partition)
        {
            partition = null;
            if (!ValidSettings(pieceCount, minAreaRatio, maxAreaRatio, minLegRatio) ||
                float.IsNaN(surfaceAspect) || float.IsInfinity(surfaceAspect) || surfaceAspect <= 0f)
                return false;
            long requiredCells = (long)pieceCount * Mathf.Max(6, targetCellsPerRectangle);
            int columns = Mathf.Max(1, Mathf.CeilToInt(Mathf.Sqrt(requiredCells * surfaceAspect)));
            int rows = Mathf.Max(1, Mathf.CeilToInt(requiredCells / (float)columns));
            if ((long)columns * rows > 4000000) return false;
            return new BalancedPartitionPlanner(null, columns, rows, pieceCount,
                maxRectanglesPerPiece < 2 ? 0f : complexPieceRatio, maxComplexLegAspect, maxPieceAspect,
                seed, minAreaRatio, maxAreaRatio, minLegRatio).TryBuild(pieceCount, out partition);
        }

        internal static bool ValidSettings(int count, float minArea, float maxArea, float minLeg)
        {
            return count > 0 && count <= 100000 && minArea > 0f && minArea <= 1f &&
                maxArea >= 1f && maxArea <= 3f && minLeg > 0f && minLeg <= 0.5f;
        }

        internal static int CountConcaveCorners(ICollection<Vector2Int> cells)
        {
            return CountConcaveCorners(cells, Array.Empty<Vector2Int>());
        }

        private static int CountConcaveCorners(ICollection<Vector2Int> first,
            ICollection<Vector2Int> second)
        {
            BoundsInt bounds = CalculateBounds(first, second);
            int count = 0;
            for (int z = bounds.yMin; z <= bounds.yMax; z++)
            for (int x = bounds.xMin; x <= bounds.xMax; x++)
            {
                int occupied = 0;
                if (Contains(first, second, x - 1, z - 1)) occupied++;
                if (Contains(first, second, x, z - 1)) occupied++;
                if (Contains(first, second, x - 1, z)) occupied++;
                if (Contains(first, second, x, z)) occupied++;
                if (occupied == 3) count++;
            }
            return count;
        }

        private static bool Contains(ICollection<Vector2Int> first,
            ICollection<Vector2Int> second, int x, int z)
        {
            Vector2Int cell = new Vector2Int(x, z);
            return first.Contains(cell) || second.Contains(cell);
        }

        internal static float CalculateAspect(IEnumerable<Vector2Int> cells)
        {
            BoundsInt bounds = CalculateBounds(cells, Array.Empty<Vector2Int>());
            int shortest = Mathf.Max(1, Mathf.Min(bounds.size.x, bounds.size.y));
            return Mathf.Max(bounds.size.x, bounds.size.y) / (float)shortest;
        }

        private static BoundsInt CalculateBounds(IEnumerable<Vector2Int> first, IEnumerable<Vector2Int> second)
        {
            int minX = int.MaxValue;
            int minY = int.MaxValue;
            int maxX = int.MinValue;
            int maxY = int.MinValue;
            AccumulateBounds(first, ref minX, ref minY, ref maxX, ref maxY);
            AccumulateBounds(second, ref minX, ref minY, ref maxX, ref maxY);
            return new BoundsInt(minX, minY, 0, maxX - minX + 1, maxY - minY + 1, 1);
        }

        private static void AccumulateBounds(IEnumerable<Vector2Int> cells, ref int minX, ref int minY,
            ref int maxX, ref int maxY)
        {
            foreach (Vector2Int cell in cells)
            {
                minX = Mathf.Min(minX, cell.x);
                minY = Mathf.Min(minY, cell.y);
                maxX = Mathf.Max(maxX, cell.x);
                maxY = Mathf.Max(maxY, cell.y);
            }
        }

    }
}
