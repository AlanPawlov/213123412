            _minLegThicknessRatio = Mathf.Clamp(_minLegThicknessRatio, 0.1f, 0.5f);
            _pieceCount = Mathf.Max(1, _pieceCount);
            _maxRectanglesPerPiece = 2;
            _maxComplexLegAspect = Mathf.Clamp(_maxComplexLegAspect, 1.25f, 4f);
            _maxPieceAspect = Mathf.Clamp(_maxPieceAspect, 1.25f, 4f);
            _targetCellsPerRectangle = Mathf.Clamp(_targetCellsPerRectangle, 6, 24);
